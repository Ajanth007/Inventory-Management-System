-- 2) Received purchases -> stock in
INSERT INTO stock_movements (company_id, product_id, type, qty, reference_type, reference_id, note, created_by, created_at)
SELECT p.company_id, pi.product_id, 'in', pi.qty, 'purchase', p.id, p.number, 2, TIMESTAMP(p.purchase_date, '10:00:00')
FROM purchase_items pi JOIN purchases p ON p.id = pi.purchase_id WHERE p.status = 'received';

-- 3) Confirmed / completed sales -> stock out (cancelled sales never touch stock)
INSERT INTO stock_movements (company_id, product_id, type, qty, reference_type, reference_id, note, created_by, created_at)
SELECT s.company_id, si.product_id, 'out', -si.qty, 'sale', s.id, s.number, s.created_by, TIMESTAMP(s.sale_date, '15:00:00')
FROM sale_items si JOIN sales s ON s.id = si.sale_id WHERE s.status IN ('confirmed','completed');

