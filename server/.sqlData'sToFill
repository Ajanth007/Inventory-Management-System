-- ---------------------------------------------------------------- invoices & payments
-- One invoice per sale except S-0405 (cancelled) and S-0411 (not invoiced yet): INV-0301 … INV-0310.
INSERT INTO invoices (company_id, sale_id, customer_id, number, issued_at, due_date, total, paid_amount, status)
SELECT s.company_id, s.id, s.customer_id,
       CONCAT('INV-', LPAD(300 + ROW_NUMBER() OVER (ORDER BY s.number), 4, '0')),
       s.sale_date, s.sale_date + INTERVAL 15 DAY, s.total, 0, 'pending'
FROM sales s
WHERE s.company_id = 1 AND s.number IN ('S-0401','S-0402','S-0403','S-0404','S-0406','S-0407','S-0408','S-0409','S-0410','S-0412');

INSERT INTO payments (company_id, invoice_id, customer_id, reference, method, amount, paid_at, created_by)
SELECT 1, i.id, i.customer_id, x.ref, x.method, x.amount, NOW() - INTERVAL x.ago DAY, 3
FROM (
  SELECT 'INV-0301' inv, 'PAY-0101' ref, 'transfer' method, 900.00  amount, 27 ago UNION ALL
  SELECT 'INV-0302',     'PAY-0102',     'cash',            660.00,         25 UNION ALL
  SELECT 'INV-0303',     'PAY-0103',     'card',            300.00,         23 UNION ALL
  SELECT 'INV-0303',     'PAY-0104',     'card',            180.00,         15 UNION ALL
  SELECT 'INV-0304',     'PAY-0105',     'cash',            100.00,         18 UNION ALL
  SELECT 'INV-0305',     'PAY-0106',     'transfer',       1000.00,         13 UNION ALL
  SELECT 'INV-0305',     'PAY-0107',     'transfer',        550.00,          6 UNION ALL
  SELECT 'INV-0306',     'PAY-0108',     'card',            200.00,          8 UNION ALL
  SELECT 'INV-0309',     'PAY-0109',     'cash',            588.00,          2 UNION ALL
  SELECT 'INV-0310',     'PAY-0110',     'card',           1675.00,          0
) x JOIN invoices i ON i.company_id = 1 AND i.number = x.inv;

-- Invoice balances and status come from the payments above.
UPDATE invoices i SET paid_amount = COALESCE((SELECT SUM(amount) FROM payments WHERE invoice_id = i.id), 0);
UPDATE invoices SET status = CASE
  WHEN paid_amount >= total              THEN 'paid'
  WHEN paid_amount > 0 AND due_date >= CURDATE() THEN 'partial'
  WHEN due_date < CURDATE()              THEN 'overdue'
  ELSE 'pending' END;

